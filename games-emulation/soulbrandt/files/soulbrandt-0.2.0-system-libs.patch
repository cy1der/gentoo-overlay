 # The file also names SDL3's headers (PS3RECOMP_SDL3_INCLUDE_DIRS), for the
 # port's own SDL code off Windows: the menus' window, keys and mouse use the
 # SDL3 the runtime links, never a second SDL.
+# Gentoo: the system libraries the runtime links. Its file lists only the static libraries built with it, so they are
+# named here. SDL3's headers are in the default include path (the UI takes SDL3::Headers itself).
+find_package(SDL3 REQUIRED CONFIG COMPONENTS SDL3-shared)
+find_package(SPIRV-Tools REQUIRED CONFIG)
+find_package(SPIRV-Tools-opt REQUIRED CONFIG)
+find_package(glslang REQUIRED CONFIG)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(DES_MINIUPNPC REQUIRED IMPORTED_TARGET miniupnpc)
+set(DES_SYSTEM_RUNTIME_DEPS glslang::glslang glslang::glslang-default-resource-limits SPIRV-Tools-opt SPIRV-Tools
+    PkgConfig::DES_MINIUPNPC SDL3::SDL3-shared)
 function(des_runtime_deps target lib)
+    set_property(TARGET ${target} APPEND PROPERTY INTERFACE_LINK_LIBRARIES ${DES_SYSTEM_RUNTIME_DEPS})
     get_filename_component(_dir "${lib}" DIRECTORY)
     set(_file "${_dir}/ps3recomp_runtime_deps.cmake")
     if(NOT EXISTS "${_file}")
