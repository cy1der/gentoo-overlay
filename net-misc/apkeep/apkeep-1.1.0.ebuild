RUST_MIN_VER="1.89.0"

inherit cargo

DESCRIPTION="Command-line tool for downloading APK files from various sources"
HOMEPAGE="
	https://www.eff.org/pages/apkeep
	https://github.com/EFForg/apkeep
"
SRC_URI="
	https://github.com/EFForg/apkeep/archive/refs/tags/${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+=" Apache-2.0 BSD BZIP2 CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0 ZLIB || ( CC0-1.0 MIT-0 )"
SLOT="0"
KEYWORDS="~amd64"

DEPEND="
	app-arch/zstd:=
	dev-libs/openssl:=
"
RDEPEND="${DEPEND}"
BDEPEND="virtual/pkgconfig"

src_prepare() {
	# Download paid apps the account owns, upstream won't (issue #190)
	pushd "${ECARGO_VENDOR}"/gpapi-6.1.0 >/dev/null || die
	eapply "${FILESDIR}"/${PN}-1.1.0-gpapi-owned-paid-apps.patch
	popd >/dev/null || die

	default
}

src_configure() {
	# Link the system zstd instead of the bundled copy
	export ZSTD_SYS_USE_PKG_CONFIG=1
	cargo_src_configure
}

src_install() {
	cargo_src_install
	dodoc CHANGELOG.md README.md USAGE USAGE-*.md
}
